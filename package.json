{
  "name": "clausery",
  "version": "1.59.0",
  "private": true,
  "description": "Clausery: invoices, quotes and receipts in Word. Turn templates into guided questionnaires and generate editable documents on your device.",
  "type": "module",
  "scripts": {
    "build:vendor": "node tools/build-vendor.mjs",
    "build:samples": "node tools/make-samples.mjs && node tools/make-pack.mjs",
    "build:sitemap": "node tools/make-sitemap.mjs",
    "build": "npm run build:vendor && npm run build:samples && npm run build:site && npm run build:sitemap && npm run release && node tools/stamp-cmi.mjs && node tools/attest.mjs",
    "lint": "eslint .",
    "test": "node --test 'tests/unit/*.test.mjs'",
    "test:e2e": "playwright test",
    "check:html": "node tools/check-html.mjs",
    "check:seo": "node tools/check-seo.mjs",
    "check:feeds": "node tools/check-feeds.mjs",
    "serve": "node tools/serve.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "marketing:assets": "node tools/make-marketing-assets.mjs",
    "previews": "node tools/make-previews.mjs",
    "license": "node tools/license.mjs",
    "verify": "npm run lint && npm run check:html && npm run check:seo && npm run check:feeds && npm run check:intent && npm run check:schema && npm run check:sitemap && npm run check:cwv && npm run check:pages && npm test",
    "build:site": "node tools/build-site.mjs",
    "smoke": "node tools/smoke.mjs",
    "release": "node tools/release.mjs",
    "indexnow": "node tools/indexnow.mjs",
    "check:intent": "node tools/check-intent.mjs",
    "check:schema": "node tools/check-schema.mjs",
    "check:sitemap": "node tools/check-sitemap.mjs",
    "check:cwv": "node tools/check-cwv.mjs",
    "check:pages": "node tools/check-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "docx": "^9.5.1",
    "docx-preview": "^0.4.1",
    "docxtemplater": "^3.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jszip": "^3.10.2",
    "parse5": "^8.0.1",
    "pizzip": "^3.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later",
  "author": "The Clausery authors",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/getclausery"
  }
}
