{
  "id": "/app/?utm_source=pwa",
  "name": "Clausery — free Word invoices (open-source)",
  "short_name": "Clausery",
  "description": "Independent open-source tool for free Word invoices, quotes and receipts. Document automation that never leaves your browser. Not affiliated with Clausery.ai.",
  "start_url": "./index.html?utm_source=pwa",
  "scope": "../",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en-GB",
  "dir": "ltr",
  "background_color": "#f6f4ef",
  "theme_color": "#f6f4ef",
  "icons": [
    { "src": "../assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "../assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "categories": ["business", "productivity"],
  "shortcuts": [
    { "name": "New invoice", "short_name": "Invoice", "url": "./#/start/invoice", "description": "Start a new invoice from the free template" },
    { "name": "New quote", "short_name": "Quote", "url": "./#/start/quote" },
    { "name": "New receipt", "short_name": "Receipt", "url": "./#/start/receipt" },
    { "name": "Outstanding invoices", "short_name": "Drafts", "url": "./#/drafts", "description": "See drafts sorted by overdue/sent/ready" },
    { "name": "Templates", "short_name": "Templates", "url": "./#/templates", "description": "Open your template library" }
  ],
  "screenshots": [
    { "src": "../assets/screenshot-invoice.png", "sizes": "1200x800", "type": "image/png", "form_factor": "wide", "label": "An invoice being filled in" }
  ]
}
